generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, vector]
}

// ───────────────────────── IDENTITY & TENANCY ─────────────────────────

model User {
  id          String    @id @db.Uuid
  email       String    @unique
  fullName    String?   @map("full_name")
  avatarUrl   String?   @map("avatar_url")
  locale      Locale    @default(FI)
  timezone    String    @default("Europe/Helsinki")
  onboardedAt DateTime? @map("onboarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships           OrganizationMember[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  messages              Message[]
  activities            Activity[]
  documentUploadIntents DocumentUploadIntent[]
  assignedInboxThreads  InboxThread[]
  approvedInboxMessages InboxMessage[]

  @@map("users")
}

enum Locale {
  EN
  FI
  AR
}

model Organization {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String    @unique
  type             OrgType   @default(BUSINESS)
  logoUrl          String?   @map("logo_url")
  businessId       String?   @map("business_id")
  vatId            String?   @map("vat_id")
  defaultLocale    Locale    @default(FI)
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  settings         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  members               OrganizationMember[]
  invitations           Invitation[]
  teams                 Team[]
  subscription          Subscription?
  usageRecords          UsageRecord[]
  contacts              Contact[]
  companies             Company[]
  deals                 Deal[]
  pipelines             Pipeline[]
  activities            Activity[]
  calendarEvents        CalendarEvent[]
  calendarConnections   CalendarConnection[]
  externalCalendars     ExternalCalendar[]
  calendarSyncStates    CalendarSyncState[]
  availabilitySchedules AvailabilitySchedule[]
  bookingTypes          BookingType[]
  bookings              Booking[]
  reminders             Reminder[]
  conversations         Conversation[]
  documents             Document[]
  conversationDocuments ConversationDocument[]
  documentUploadIntents DocumentUploadIntent[]
  collections           Collection[]
  prompts               Prompt[]
  workflows             Workflow[]
  workflowRuns          WorkflowRun[]
  voiceAssistants       VoiceAssistant[]
  voiceCalls            VoiceCall[]
  notifications         Notification[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  auditLogs             AuditLog[]
  tags                  Tag[]
  businessDNA           BusinessDNA?
  inboxThreads          InboxThread[]
  inboxMailboxes        InboxMailbox[]

  @@map("organizations")
}

enum OrgType {
  PERSONAL
  BUSINESS
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role     @default(MEMBER)
  teamId         String?  @map("team_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@index([organizationId])
  @@map("teams")
}

model Invitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  role           Role         @default(MEMBER)
  token          String       @unique @default(dbgenerated("gen_random_uuid()"))
  invitedById    String       @map("invited_by_id") @db.Uuid
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("invitations")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ───────────────────────── BUSINESS DNA ─────────────────────────

/**
 * Business DNA: the operational business context AI Chat, Voice, Inbox draft
 * generation, the Booking assistant (assistScheduling), and the CRM deal
 * sales-coach (generateDealInsights) read (via the shared
 * `getBusinessDnaContext`/`buildBusinessDnaPromptBlock` helpers in
 * `src/server/business-dna/context.ts` — every consumer must go through
 * those, not a direct query, so field coverage never drifts between
 * channels) to act on the organization's behalf. One profile per
 * organization (MVP scope only — see docs/DEVELOPMENT.md before widening
 * this model). `sourceUrl`/`extractedAt` record provenance of the last
 * AI-assisted extraction; raw scraped content is intentionally never
 * persisted here.
 */
model BusinessDNA {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  displayName        String?  @map("display_name")
  industry           String?
  productsServices   String?  @map("products_services")
  supportedLocales   Locale[] @default([]) @map("supported_locales")
  brandTone          String?  @map("brand_tone")
  communicationStyle String?  @map("communication_style")
  openingHours       Json?    @map("opening_hours")
  policies           String?
  pricingNotes       String?  @map("pricing_notes")
  targetCustomer     String?  @map("target_customer")
  keyFacts           String[] @default([]) @map("key_facts")

  sourceUrl   String?   @map("source_url")
  extractedAt DateTime? @map("extracted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_dna")
}

// ───────────────────────── BILLING ─────────────────────────

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @unique @map("organization_id") @db.Uuid
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  plan                 Plan      @default(FREE)
  status               SubStatus @default(ACTIVE)
  seats                Int       @default(1)
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  trialEndsAt          DateTime? @map("trial_ends_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  PAUSED
}

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

/// Durable idempotency ledger for inbound Stripe webhook events (§14.4).
/// Keyed by Stripe's own globally-unique event id, not by organization --
/// every lookup is `WHERE stripe_event_id = ...`, never org-scoped, so this
/// is deliberately excluded from `TENANT_MODELS` (src/server/db/tenant.ts),
/// the same way `User`/`Organization` are: it is Syveka's own cross-tenant
/// operational state, not tenant-owned data. `organizationId` is nullable,
/// best-effort metadata for observability once an event resolves to an org
/// -- never an access-control boundary for this table.
model StripeWebhookEvent {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId  String                   @unique @map("stripe_event_id")
  eventType      String                   @map("event_type")
  status         StripeWebhookEventStatus @default(RECEIVED)
  organizationId String?                  @map("organization_id") @db.Uuid
  objectId       String?                  @map("object_id")
  attempts       Int                      @default(0)
  lastError      String?                  @map("last_error")
  firstSeenAt    DateTime                 @default(now()) @map("first_seen_at")
  lastAttemptAt  DateTime?                @map("last_attempt_at")
  completedAt    DateTime?                @map("completed_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@index([status, lastAttemptAt])
  @@map("stripe_webhook_events")
}

model UsageRecord {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  metric         UsageMetric
  quantity       Int
  periodStart    DateTime    @map("period_start")
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, periodStart])
  @@map("usage_records")
}

enum UsageMetric {
  AI_TOKENS_IN
  AI_TOKENS_OUT
  AI_MESSAGES
  VOICE_MINUTES
  EMBEDDINGS
  STORAGE_MB
  WORKFLOW_RUNS
  API_CALLS
}

// ───────────────────────── CRM ─────────────────────────

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  domain         String?
  businessId     String?   @map("business_id")
  industry       String?
  size           String?
  website        String?
  address        Json?
  customFields   Json      @default("{}") @map("custom_fields")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("companies")
}

model Contact {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String?       @map("company_id") @db.Uuid
  ownerId        String?       @map("owner_id") @db.Uuid
  firstName      String        @map("first_name")
  lastName       String?       @map("last_name")
  email          String?
  phone          String?
  title          String?
  status         ContactStatus @default(LEAD)
  source         String?
  locale         Locale?
  gdprConsentAt  DateTime?     @map("gdpr_consent_at")
  customFields   Json          @default("{}") @map("custom_fields")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  archivedAt     DateTime?     @map("archived_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals          Deal[]
  activities     Activity[]
  tags           TagsOnContacts[]
  eventAttendees EventAttendee[]
  inboxThreads   InboxThread[]

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("contacts")
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
  ARCHIVED
}

model Pipeline {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean @default(false) @map("is_default")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId  String  @map("pipeline_id") @db.Uuid
  name        String
  order       Int
  probability Int     @default(0)
  isWon       Boolean @default(false) @map("is_won")
  isLost      Boolean @default(false) @map("is_lost")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
  @@map("pipeline_stages")
}

model Deal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  contactId       String?   @map("contact_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  ownerId         String?   @map("owner_id") @db.Uuid
  title           String
  valueCents      Int       @default(0) @map("value_cents")
  currency        String    @default("EUR")
  probability     Int?
  position        Int       @default(0)
  expectedCloseAt DateTime? @map("expected_close_at")
  closedAt        DateTime? @map("closed_at")
  lostReason      String?   @map("lost_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId, stageId])
  @@index([organizationId, closedAt])
  @@index([organizationId, pipelineId, closedAt])
  @@index([organizationId, ownerId])
  @@map("deals")
}

model Activity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  type           ActivityType
  subject        String
  body           String?
  dueAt          DateTime?    @map("due_at")
  completedAt    DateTime?    @map("completed_at")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, dueAt])
  @@index([organizationId, type, dueAt])
  @@index([organizationId, type, createdAt])
  @@index([contactId])
  @@index([companyId])
  @@map("activities")
}

enum ActivityType {
  NOTE
  TASK
  CALL
  EMAIL
  MEETING
  VOICE_AI_CALL
  AI_SUMMARY
  STAGE_CHANGE
}

model Tag {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  color          String @default("#6366f1")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     TagsOnContacts[]

  @@unique([organizationId, name])
  @@map("tags")
}

model TagsOnContacts {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("tags_on_contacts")
}

// ───────────────────────── INBOX ─────────────────────────

/**
 * Inbox MVP foundation: the data layer for a unified, channel-agnostic
 * conversation surface (email/SMS/WhatsApp/web chat today; extensible to
 * more). Server-only for now — no RLS client policies are granted (see
 * the migration), matching document_upload_intents/calendar_connections,
 * since every access path in this MVP goes through the audited, RBAC-
 * checked service layer, not a direct Supabase client query.
 * Explicitly out of scope for this foundation slice (tracked as follow-up,
 * not silently deferred): actual channel-provider dispatch (sending a
 * message for real requires picking and configuring a provider — a product
 * decision, not an engineering one) and AI draft generation (a natural
 * next step once a provider is chosen, reusing the Business DNA system-
 * prompt wiring already built for chat).
 */
/**
 * One inbound address per organization per channel — the server-controlled
 * mapping an inbound webhook resolves the organization from. Never trust an
 * organization id supplied directly in an inbound payload; always resolve
 * it through this table via the verified recipient address instead.
 */
model InboxMailbox {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  channel        InboxChannel @default(EMAIL)
  address        String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@unique([channel, address])
  @@map("inbox_mailboxes")
}

model InboxThread {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  channel        InboxChannel
  status         InboxThreadStatus @default(OPEN)
  subject        String?
  contactId      String?           @map("contact_id") @db.Uuid
  assignedToId   String?           @map("assigned_to_id") @db.Uuid
  externalId     String?           @map("external_id")
  lastMessageAt  DateTime?         @map("last_message_at")
  /**
   * Null = unread (reset to null whenever a new inbound message arrives).
   */
  readAt         DateTime?         @map("read_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo   User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     InboxMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([contactId])
  @@map("inbox_threads")
}

enum InboxChannel {
  EMAIL
  SMS
  WHATSAPP
  WEB_CHAT
}

enum InboxThreadStatus {
  OPEN
  PENDING
  CLOSED
}

/**
 * Scoped via `threadId` only, like `Message` is via `conversationId` — see
 * the DOCUMENTED_EXCLUSIONS comment in src/server/db/tenant.ts.
 */
model InboxMessage {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId     String                @map("thread_id") @db.Uuid
  direction    InboxMessageDirection
  status       InboxMessageStatus    @default(RECEIVED)
  fromAddress  String?               @map("from_address")
  toAddress    String?               @map("to_address")
  body         String
  aiGenerated  Boolean               @default(false) @map("ai_generated")
  approvedById String?               @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?             @map("approved_at")
  sentAt       DateTime?             @map("sent_at")
  /**
   * Provider message id (e.g. RFC 5322 Message-ID). Globally unique per
   * provider by construction, so a plain unique constraint doubles as
   * webhook-redelivery idempotency — multiple NULLs remain allowed.
   */
  externalId   String?               @unique @map("external_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  thread     InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("inbox_messages")
}

enum InboxMessageDirection {
  INBOUND
  OUTBOUND
}

/**
 * RECEIVED is the terminal state for INBOUND messages. OUTBOUND messages
 * move DRAFT -> APPROVED -> SENT (or FAILED); AI-generated drafts require
 * an explicit approval before they may be sent (see upsertInboxMessage).
 */
enum InboxMessageStatus {
  RECEIVED
  DRAFT
  APPROVED
  SENT
  FAILED
}

// ───────────────────────── CALENDAR & BOOKING ─────────────────────────

model CalendarEvent {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  createdById        String      @map("created_by_id") @db.Uuid
  ownerId            String?     @map("owner_id") @db.Uuid
  title              String
  description        String?
  location           String?
  timezone           String      @default("Europe/Helsinki")
  startsAt           DateTime    @map("starts_at")
  endsAt             DateTime    @map("ends_at")
  allDay             Boolean     @default(false) @map("all_day")
  recurrenceRule     String?     @map("recurrence_rule")
  status             EventStatus @default(CONFIRMED)
  contactId          String?     @map("contact_id") @db.Uuid
  companyId          String?     @map("company_id") @db.Uuid
  dealId             String?     @map("deal_id") @db.Uuid
  source             EventSource @default(MANUAL)
  externalCalendarId String?     @map("external_calendar_id") @db.Uuid
  externalId         String?     @map("external_id")
  externalEtag       String?     @map("external_etag")
  attendees          Json        @default("[]") // deprecated: use EventAttendee rows
  canceledAt         DateTime?   @map("canceled_at")
  deletedAt          DateTime?   @map("deleted_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalCalendar ExternalCalendar? @relation(fields: [externalCalendarId], references: [id], onDelete: SetNull)
  attendeeRecords  EventAttendee[]
  booking          Booking?
  reminders        Reminder[]

  @@unique([externalCalendarId, externalId])
  @@index([organizationId, startsAt])
  @@index([organizationId, ownerId, startsAt])
  @@index([organizationId, contactId, startsAt])
  @@index([organizationId, companyId, startsAt])
  @@index([organizationId, dealId, startsAt])
  @@map("calendar_events")
}

enum EventSource {
  MANUAL
  VOICE_AI
  WORKFLOW
  BOOKING
  GOOGLE
  OUTLOOK
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELED
}

/// Tenant-scoped via parent CalendarEvent (like Message → Conversation).
model EventAttendee {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  contactId   String?        @map("contact_id") @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  email       String?
  name        String?
  status      AttendeeStatus @default(PENDING)
  isOrganizer Boolean        @default(false) @map("is_organizer")
  createdAt   DateTime       @default(now()) @map("created_at")

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([contactId])
  @@map("event_attendees")
}

enum AttendeeStatus {
  PENDING
  ACCEPTED
  DECLINED
