+describe("scripts written and run in one command", () => {
+  const code = `const fs=require('fs'),os=require('os'),path=require('path');
+fs.readFileSync(path.join(os.homedir(),'${CLAUDE_JSON}'),'utf8')`;
+  const shell = `cat ~/${CLAUDE_JSON}`;
+
+  it.each([
+    ["a JavaScript heredoc", `cat > /tmp/x.js <<'EOF'\n${code}\nEOF\nnode /tmp/x.js`],
+    ["a shell heredoc", `cat > /tmp/x.sh <<'EOF'\n${shell}\nEOF\nbash /tmp/x.sh`],
+    ["direct execution", `cat > /tmp/x.sh <<'EOF'\n${shell}\nEOF\nchmod +x /tmp/x.sh; /tmp/x.sh`],
+    ["a chained line", `cat > /tmp/x.js <<'EOF' && node /tmp/x.js\n${code}\nEOF`],
+    [
+      "a harmless append after the payload",
+      `cat > x.sh <<'A'\n${shell}\nA\ncat >> x.sh <<'B'\necho hi\nB\nbash x.sh`,
+    ],
+    ["tee with a heredoc", `tee /tmp/x.js <<'EOF'\n${code}\nEOF\nnode /tmp/x.js`],
+    ["a heredoc piped into tee", `cat <<'EOF' | tee /tmp/x.js\n${code}\nEOF\nnode /tmp/x.js`],
+    ["stdin redirection", `cat > /tmp/x.js <<'EOF'\n${code}\nEOF\nnode < /tmp/x.js`],
+    ["node --import", `cat > /tmp/x.mjs <<'EOF'\n${code}\nEOF\nnode --import=/tmp/x.mjs app.js`],
+    [
+      "a versioned python",
+      `cat > /tmp/x.py <<'EOF'\nopen('${CLAUDE_JSON}')\nEOF\npython3.12 /tmp/x.py`,
+    ],
+    [
+      "a heredoc piped through a redirecting cat",
+      `cat <<'EOF' | cat > /tmp/x.js && node /tmp/x.js\n${code}\nEOF`,
+    ],
+    [
+      "a harmless script later rewritten",
+      `cat > /tmp/x.sh <<'A'\necho ok\nA\nbash /tmp/x.sh\ncat > /tmp/x.sh <<'B'\n${shell}\nB\nbash /tmp/x.sh`,
+    ],
+  ])("denies %s", async (_label, command) => {
+    expect(await bash(command)).toBe("deny");
+  });
+
+  it("keeps a script's variables out of the caller", async () => {
+    const command = `p=.env\ncat > x.sh <<'EOF'\np=safe\nEOF\nbash x.sh\ncat "$p"`;
+    expect(await bash(command)).toBe("deny");
+  });
+
+  it("does not read a data argument as the script", async () => {
+    const write = `cat > data.json <<'EOF'\n{"p":".env.local"}\nEOF`;
+    expect(await bash(`${write}\nnode tool.js data.json`)).toBe("allow");
+  });
+
+  it("allows a benign heredoc script", async () => {
+    expect(await bash(`cat > /tmp/s.js <<'EOF'\nconsole.log('hi')\nEOF\nnode /tmp/s.js`)).toBe(
+      "allow",
+    );
+  });
+
+  it("allows heredoc text that only mentions the file and is never run", async () => {
+    expect(await bash(`cat > /tmp/n.txt <<'EOF'\n'${CLAUDE_JSON}' holds state\nEOF`)).toBe("allow");
+  });
+
+  it("ignores a heredoc-style write to stderr", async () => {
+    expect(await bash(`cat 2> /tmp/e.log <<'EOF'\nhello\nEOF\nnode /tmp/e.log`)).toBe("allow");
+  });
+
+  it("finishes on a script that runs itself", async () => {
+    expect(await bash(`cat > a.sh <<'EOF'\nbash a.sh\nbash a.sh\nEOF\nbash a.sh`)).toBe("allow");
+  });
+
+  it.each([
+    `echo "readFileSync('${CLAUDE_JSON}')" | node`,
+    `echo "readFileSync('/tmp/.ssh/id_x')" | node`,
+    `echo "readFileSync('${CLAUDE_JSON}')" | node /dev/stdin`,
+  ])("denies piped code: %s", async (command) => {
+    expect(await bash(command)).toBe("deny");
+  });
+
+  it("allows plain code piped into an interpreter", async () => {
+    expect(await bash(`echo "console.log(1)" | node`)).toBe("allow");
+  });
+
+  it("does not treat stdin data for inline code as a script", async () => {
+    expect(await bash(`cat data.txt | node -e "console.log(1)"`)).toBe("allow");
+  });
+
+  it("does not treat an interpreter flag as reading a script", async () => {
+    expect(await bash("git status; node --version")).toBe("allow");
+  });
+});
