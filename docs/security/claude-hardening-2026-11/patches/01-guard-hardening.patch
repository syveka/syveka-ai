+import { spawn, spawnSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+// Synthetic payloads only: the guards classify the text and nothing in it is executed. The
+// home directory is a temporary fixture, so no real credential file is ever looked at.
+const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "..");
+const HOOKS = path.join(REPO_ROOT, ".claude", "hooks");
+
+vi.setConfig({ testTimeout: 120_000, hookTimeout: 120_000 });
+
+// Mixed case on purpose: the guards lower-case paths, and a case-sensitive file system must
+// still find these checkouts.
+const BASE = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "Syveka-Guard-")));
+const HOME = path.join(BASE, "Home");
+const P = HOME.replace(/\\/g, "/");
+const SESSION = path.join(BASE, "Session");
+const S = SESSION.replace(/\\/g, "/");
+const SIBLING = path.join(BASE, "Sibling");
+const OTHER_REPO = path.join(BASE, "Other-Repo");
+const CLAUDE_JSON = ".claude.json";
+const fileUrl = (posixPath: string) => `file:///${posixPath.replace(/^\//, "")}`;
+
+type Decision = "allow" | "ask" | "deny";
+type Payload = { tool_name: string; tool_input: Record<string, unknown>; cwd?: string };
+
+// Isolated from the developer's git configuration and from any GIT_* a calling hook exports.
+function gitEnv() {
+  const env: NodeJS.ProcessEnv = { ...process.env, HOME, USERPROFILE: HOME };
+  for (const name of Object.keys(env)) if (name.startsWith("GIT_")) delete env[name];
+  env.GIT_CONFIG_NOSYSTEM = "1";
+  return env;
+}
+
+function git(cwd: string, ...args: string[]) {
+  const identity = ["-c", "user.name=guard-test", "-c", "user.email=guard-test@example.invalid"];
+  const result = spawnSync("git", [...identity, "-c", "commit.gpgsign=false", ...args], {
+    cwd,
+    encoding: "utf8",
+    env: gitEnv(),
+  });
+  if (result.status !== 0) throw new Error(`git ${args.join(" ")}: ${result.stderr}`);
+}
+
+function evaluate(hook: string, payload: Payload): Promise<Decision> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [path.join(HOOKS, `${hook}.mjs`)], {
+      env: {
+        ...gitEnv(),
+        CLAUDE_PROJECT_DIR: SESSION,
+        SYVEKA_ALLOW_PROTECTED_CONFIG_EDIT: "",
+      },
+    });
+    let stdout = "";
+    child.stdout.on("data", (chunk) => (stdout += chunk));
+    child.stderr.resume();
+    child.on("error", reject);
+    child.on("close", (status) => {
+      if (status === 2) resolve("deny");
+      else if (status === 0)
+        resolve(stdout.includes('"permissionDecision":"ask"') ? "ask" : "allow");
+      else reject(new Error(`unexpected exit ${status}`));
+    });
+    child.stdin.end(JSON.stringify({ cwd: SESSION, ...payload }));
+  });
