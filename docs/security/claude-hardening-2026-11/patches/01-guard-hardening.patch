+
+  it.each([
+    ["a range glob", `curl "${fileUrl(`${P}/.claude.jso[m-o]`)}"`],
+    ["a fragment inside braces", `curl ${fileUrl(`${P}/{a#,.ssh/id_x}`)}`],
+    ["a query inside braces", `curl ${fileUrl(`${P}/{a?,${CLAUDE_JSON}}`)}`],
+    ["a literal path that looks like a URL", `cat 'file:///a#/../../.env'`],
+    ["a write through the same spelling", `tee 'file:///a#/../../CLAUDE.md'`],
+  ])("Bash denies %s", async (_label, command) => {
+    expect(await bash(command)).toBe("deny");
