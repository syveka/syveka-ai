+
+  it("denies an MCP read with a fragment hiding a traversal", async () => {
+    const value = fileUrl(`/tmp/#/../${P.replace(/^\//, "")}/.ssh/id_x`);
+    expect(await mcp("mcp__fs__read_file", { path: value })).toBe("deny");
+  });
+
+  it("decodes the valid escapes beside a malformed one", async () => {
+    const value = `${P}/x%FF%2F%2E%2E%2F%2Essh%2Fid_x`;
+    expect(await mcp("mcp__fs__read_file", { path: value })).toBe("deny");
+  });
+
+  it("allows ordinary MCP input", async () => {
