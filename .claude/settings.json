{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Monitor|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 45 node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/command-guard.mjs\" || exit 2"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Read|Grep)$",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 45 node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/config-protection.mjs\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const o=JSON.parse(d);const f=o.tool_input&&o.tool_input.file_path;if(f)process.stdout.write(f);}catch(e){}})\" | { read -r f; [ -n \"$f\" ] && npx prettier --ignore-unknown --write \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
